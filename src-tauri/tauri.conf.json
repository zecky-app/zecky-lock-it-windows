{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zecky Lock it",
  "version": "0.0.2",
  "identifier": "app.zecky.lockit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zecky Lock it",
        "width": 440,
        "height": 760,
        "minWidth": 400,
        "minHeight": 680,
        "backgroundColor": "#14161C"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "params/sapling-spend.params": "params/sapling-spend.params",
      "params/sapling-output.params": "params/sapling-output.params"
    }
  }
}
